# ─── Server-only ──────────────────────────────────────────────────────────────
# Base of the Express service, WITHOUT the /api/v1 suffix — the client adds it.
# Inside docker compose this is the service name; locally it is localhost.
API_URL=http://localhost:4000

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-at-least-32-characters-of-random

# ─── Browser-visible ──────────────────────────────────────────────────────────
# NOTE: NEXT_PUBLIC_* values are inlined at BUILD time. They cannot be changed
# by the runtime environment, and must never hold a secret.
#
# The browser never calls the API directly — it calls this app's BFF at
# /api/proxy, which attaches the bearer token from an httpOnly cookie. So this
# is this app's own origin, not the API's.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Map tiles. Optional until phase 5.
# NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Run the UI against MSW with no backend at all.
NEXT_PUBLIC_ENABLE_MSW=false
